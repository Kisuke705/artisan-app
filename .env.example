# Copiez ce fichier en « .env.local » et remplissez les valeurs.
# Supabase → Project Settings → API (ou la sortie de « npx supabase start » en local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-publishable-ou-anon

# Adresse publique de l'application (liens dans les emails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
